# Salin file ini ke `.env` di folder frontend-cofind (satu level dengan package.json).
# Jangan commit `.env`. Production (Vercel): set variabel yang sama di Environment Variables.

# Backend Flask API (Railway production URL, HTTPS)
# WAJIB di-set di Vercel Environment Variables, lalu Redeploy.
# Tanpa ini, build fallback ke http://localhost:5000 (gagal dari site production).
VITE_API_BASE=https://YOUR-RAILWAY-SERVICE.up.railway.app

# Supabase (frontend)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Opsional: nonaktifkan auto-login di development
# VITE_DISABLE_AUTO_LOGIN=true

# --- Peta modal rekomendasi (frontend-cofind/.env saja, bukan root cofind/.env) ---
# Default: leaflet (OpenStreetMap, tanpa API key Google).
# VITE_MAP_PROVIDER=leaflet
#
# Google Maps JS (opsional): aktifkan Maps JavaScript API di Google Cloud,
# restrict key by HTTP referrer, lalu:
# VITE_MAP_PROVIDER=google
# VITE_GOOGLE_MAPS_API_KEY=your-browser-restricted-key
