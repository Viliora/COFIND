{
  "info": {
    "name": "COFIND API (integration smoke)",
    "description": "Jalankan backend: python app.py. Lalu: npx newman run tests/newman/cofind-api.postman_collection.json --env-var baseUrl=http://127.0.0.1:5000\n\nCatatan: beberapa request membutuhkan data nyata di DB (place_id, user_id). Tes otomatis utama ada di pytest tests/integration (Flask test_client).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:5000" },
    { "key": "samplePlaceId", "value": "GANTI_dengan_place_id_dari_DB" },
    { "key": "sampleUserId", "value": "1" }
  ],
  "item": [
    {
      "name": "GET /",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/"
      }
    },
    {
      "name": "GET /api/test",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/test"
      }
    },
    {
      "name": "GET /health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "GET /api/coffeeshops",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/coffeeshops"
      }
    },
    {
      "name": "POST /api/favorites (butuh place_id valid)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": {{sampleUserId}},\n  \"place_id\": \"{{samplePlaceId}}\"\n}"
        },
        "url": "{{baseUrl}}/api/favorites"
      }
    }
  ]
}
