<mxfile host="app.diagrams.net" type="device" pages="3">
  <diagram id="cofind-pipeline" name="1. Pipeline Rekomendasi">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p1-title" value="COFIND &#8212; PIPELINE REKOMENDASI (RAG 3 FASE)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1200" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p1-sub" value="Input hanya pill dua lapis (tanpa teks bebas). Sumber: &lt;i&gt;app.py::_recommendation_pipeline_events&lt;/i&gt;, &lt;i&gt;hybrid_retrieval.py&lt;/i&gt;, &lt;i&gt;llm_recommender.py&lt;/i&gt;. Nilai default diambil dari &lt;i&gt;.env.example&lt;/i&gt;." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1560" height="30" as="geometry" />
        </mxCell>

        <mxCell id="p1-client" value="CLIENT &#8212; React 18 + Vite (Vercel)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=none;strokeColor=#6c8ebf;dashed=1;fontSize=13;fontStyle=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="300" height="660" as="geometry" />
        </mxCell>
        <mxCell id="p1-actor" value="User (wajib login)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;" vertex="1" parent="p1-client">
          <mxGeometry x="125" y="45" width="50" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p1-c1" value="&lt;b&gt;1. PILL SELECT&lt;/b&gt;&lt;br&gt;ShopList.jsx + FacilityAttributePicker&lt;br&gt;&lt;i&gt;1 pill aktivitas + maks 3 pill atribut&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="p1-client">
          <mxGeometry x="20" y="145" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p1-c2" value="&lt;b&gt;2. SSE CLIENT&lt;/b&gt;&lt;br&gt;recommendationStream.js&lt;br&gt;&lt;i&gt;fetch + ReadableStream (butuh header&lt;br&gt;Authorization), fallback ke JSON biasa&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="p1-client">
          <mxGeometry x="20" y="235" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1-c3" value="&lt;b&gt;3. PROGRESS OVERLAY&lt;/b&gt;&lt;br&gt;RecommendationProgressOverlay.jsx&lt;br&gt;&lt;i&gt;start &#8594; profiles &#8594; scoring &#8594; rerank &#8594; summary&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="p1-client">
          <mxGeometry x="20" y="335" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p1-c4" value="&lt;b&gt;4. RECOMMENDATION MODAL&lt;/b&gt;&lt;br&gt;RecommendationModal.jsx&lt;br&gt;&lt;i&gt;maks 3 kartu: ringkasan, kutipan bukti,&lt;br&gt;catatan (caveat), pill coverage&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="p1-client">
          <mxGeometry x="20" y="425" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p1-c5" value="&lt;b&gt;5. FEEDBACK&lt;/b&gt; (thumbs up / down)&lt;br&gt;POST .../feedback&lt;br&gt;&lt;i&gt;not_helpful dipakai sebagai exclusion&lt;br&gt;pada permintaan berikutnya&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="p1-client">
          <mxGeometry x="20" y="535" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="p1-legend" value="LEGENDA" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=none;strokeColor=#999999;fontSize=13;fontStyle=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="790" width="300" height="280" as="geometry" />
        </mxCell>
        <mxCell id="p1-l1" value="Tahap deterministik (non-LLM)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="p1-legend">
          <mxGeometry x="20" y="40" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p1-l2" value="Tahap memakai LLM" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="p1-legend">
          <mxGeometry x="20" y="78" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p1-l3" value="Sisi klien (browser)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="p1-legend">
          <mxGeometry x="20" y="116" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p1-l4" value="Penyimpanan data / model" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="p1-legend">
          <mxGeometry x="20" y="154" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p1-l5" value="Cache / memoisasi" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="p1-legend">
          <mxGeometry x="20" y="192" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p1-l6" value="Nonaktif / legacy (garis putus)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;dashed=1;fontColor=#666666;fontSize=11;" vertex="1" parent="p1-legend">
          <mxGeometry x="20" y="230" width="260" height="30" as="geometry" />
        </mxCell>

        <mxCell id="p1-proc" value="RECOMMENDATION PROCESS &#8212; app.py::_recommendation_pipeline_events (generator: progress + 1 result)" style="swimlane;whiteSpace=wrap;html=1;startSize=36;fillColor=none;strokeColor=#333333;fontSize=14;fontStyle=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="380" y="90" width="1220" height="1430" as="geometry" />
        </mxCell>

        <mxCell id="g0" value="FASE 0 &#8212; GERBANG REQUEST (deterministik)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=none;strokeColor=#82b366;dashed=1;fontSize=12;fontStyle=1;collapsible=0;" vertex="1" parent="p1-proc">
          <mxGeometry x="40" y="50" width="1140" height="170" as="geometry" />
        </mxCell>
        <mxCell id="b01" value="&lt;b&gt;AUTENTIKASI (BEARER)&lt;/b&gt;&lt;br&gt;auth_guards.require_authenticated_user&lt;br&gt;&lt;i&gt;sesi disimpan di Postgres&lt;/i&gt;&lt;br&gt;&lt;i&gt;gerbang COFIND_DEV_LLM_STRICT &#8594; 503&lt;br&gt;bila LLM wajib tetapi mati&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="g0">
          <mxGeometry x="20" y="45" width="340" height="105" as="geometry" />
        </mxCell>
        <mxCell id="b02" value="&lt;b&gt;PARSE + VALIDASI PILL&lt;/b&gt;&lt;br&gt;_read_recommendation_preferences&lt;br&gt;_split_preference_pills&lt;br&gt;&lt;i&gt;body {preferences, attributes}; pill harus ada&lt;br&gt;di PILL_MAPPING, kalau tidak &#8594; 400&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="g0">
          <mxGeometry x="400" y="45" width="340" height="105" as="geometry" />
        </mxCell>
        <mxCell id="b03" value="&lt;b&gt;PRA-PERSONALISASI&lt;/b&gt;&lt;br&gt;get_not_helpful_place_ids &#8594; exclusion&lt;br&gt;build_user_taste_profile +&lt;br&gt;format_user_taste_prompt_block&lt;br&gt;&lt;i&gt;ulasan sendiri, favorit, vote&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="g0">
          <mxGeometry x="780" y="45" width="340" height="105" as="geometry" />
        </mxCell>

        <mxCell id="g1" value="FASE 1 &#8212; HARD FILTER + BUILD PROFILE (deterministik)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=none;strokeColor=#82b366;dashed=1;fontSize=12;fontStyle=1;collapsible=0;" vertex="1" parent="p1-proc">
          <mxGeometry x="40" y="240" width="1140" height="180" as="geometry" />
        </mxCell>
        <mxCell id="b11" value="&lt;b&gt;LOAD SEMUA KANDIDAT&lt;/b&gt;&lt;br&gt;_load_all_place_ids&lt;br&gt;&lt;i&gt;tabel coffee_shops&lt;/i&gt;&lt;br&gt;load_facilities_index (facilities.json)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="g1">
          <mxGeometry x="20" y="45" width="340" height="115" as="geometry" />
        </mxCell>
        <mxCell id="b12" value="&lt;b&gt;BUILD PROFILE + REVIEW (BATCH)&lt;/b&gt;&lt;br&gt;_build_profiles_for_recommendation&lt;br&gt;&lt;i&gt;1 query shops + 1 query reviews lean&lt;/i&gt;&lt;br&gt;get_vote_summaries_batch&lt;br&gt;get_top_voted_pros_batch" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="g1">
          <mxGeometry x="400" y="45" width="340" height="115" as="geometry" />
        </mxCell>
        <mxCell id="b13" value="&lt;b&gt;HARD FILTER&lt;/b&gt;&lt;br&gt;&#8226; buang place_id hasil feedback not_helpful&lt;br&gt;&#8226; wajib &#8805; 1 ulasan Cofind&lt;br&gt;&#160;&#160;(REVIEW_BASED_MIN_REVIEWS = 1)&lt;br&gt;&lt;i&gt;toko tanpa ulasan tidak ikut dinilai&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="g1">
          <mxGeometry x="780" y="45" width="340" height="115" as="geometry" />
        </mxCell>

        <mxCell id="g2" value="FASE 2 &#8212; HYBRID RETRIEVAL: BM25 + EMBEDDING + GERBANG AKTIVITAS (deterministik)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=none;strokeColor=#82b366;dashed=1;fontSize=12;fontStyle=1;collapsible=0;" vertex="1" parent="p1-proc">
          <mxGeometry x="40" y="440" width="1140" height="400" as="geometry" />
        </mxCell>
        <mxCell id="b20" value="&lt;b&gt;KEYWORDS MAPPING (SPARSE)&lt;/b&gt;&lt;br&gt;build_sparse_query_tokens&lt;br&gt;&lt;i&gt;pill id + label + PILL_MAPPING.review_keywords&lt;br&gt;&#8594; token aktivitas &amp; token atribut&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="g2">
          <mxGeometry x="20" y="45" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b21" value="&lt;b&gt;QUERY TEXT (DENSE)&lt;/b&gt;&lt;br&gt;build_dense_query_text&lt;br&gt;&lt;i&gt;&quot;Cari coffee shop yang cocok untuk: &amp;lt;label&amp;gt;&quot;&lt;br&gt;query aktivitas dipisah dari atribut&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="g2">
          <mxGeometry x="400" y="45" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b23" value="&lt;b&gt;BM25 SPARSE&lt;/b&gt;&lt;br&gt;bm25_utils: build_bm25_index + score_shops_bm25&lt;br&gt;&lt;i&gt;rank_bm25.BM25Okapi; 1 dokumen = gabungan&lt;br&gt;teks ulasan per toko; skor aktivitas &amp; atribut&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="g2">
          <mxGeometry x="780" y="45" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b24" value="&lt;b&gt;DENSE EMBEDDING&lt;/b&gt;&lt;br&gt;score_shops_dense &#8594; semantic_match.score_documents&lt;br&gt;&lt;i&gt;cosine query vs ulasan, max-pool per toko&lt;br&gt;maks COFIND_DENSE_MAX_REVIEWS = 20 ulasan/toko&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="g2">
          <mxGeometry x="780" y="160" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b22" value="&lt;b&gt;GERBANG AKTIVITAS (WAJIB)&lt;/b&gt;&lt;br&gt;shop_has_activity_signal&lt;br&gt;&lt;i&gt;kata/frasa aktivitas harus benar-benar ada di&lt;br&gt;ulasan; atribut (wifi, colokan) hanya penguat&lt;br&gt;skor, bukan tiket lolos&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="g2">
          <mxGeometry x="400" y="160" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b25" value="&lt;b&gt;MINMAX + FUSI BOBOT&lt;/b&gt;&lt;br&gt;&lt;i&gt;normalisasi hanya antar toko yang lolos gerbang&lt;/i&gt;&lt;br&gt;aktivitas = 0.40&#183;bm25 + 0.35&#183;dense + 0.25&#183;leksikal&lt;br&gt;total = 0.65&#183;aktivitas + 0.25&#183;atribut + 0.10&#183;kualitas&lt;br&gt;&lt;i&gt;kualitas = 0.5&#183;overall experience + 0.5&#183;rating&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="g2">
          <mxGeometry x="20" y="160" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b26" value="&lt;b&gt;TOP-K KANDIDAT&lt;/b&gt;&lt;br&gt;retrieve_top_k &#8594; candidates[:K]&lt;br&gt;&lt;b&gt;K = COFIND_RETRIEVAL_TOP_K = 7&lt;/b&gt;&lt;br&gt;&lt;i&gt;telemetry: profiles, activity_gated, kept_with_signal&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="g2">
          <mxGeometry x="20" y="275" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b27" value="&lt;b&gt;RANK EVIDENCE PER TOKO&lt;/b&gt;&lt;br&gt;_build_retrieval_evidence &#8594; rank_reviews_for_query&lt;br&gt;&lt;i&gt;scan COFIND_PROMPT_REVIEW_SCAN = 60 ulasan,&lt;br&gt;simpan COFIND_PROMPT_REVIEW_LIMIT = 8 terbaik&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="g2">
          <mxGeometry x="400" y="275" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b28" value="&lt;b&gt;PILL COVERAGE&lt;/b&gt;&lt;br&gt;_attach_pill_coverage &#8594; compute_pill_coverage&lt;br&gt;&lt;i&gt;pill mana yang terbukti di ulasan (covered)&lt;br&gt;dan mana yang belum (uncovered)&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="g2">
          <mxGeometry x="780" y="275" width="340" height="100" as="geometry" />
        </mxCell>

        <mxCell id="g3" value="FASE 3 &#8212; LLM RERANK + EKSTRAKSI KUTIPAN + SUMMARY" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=none;strokeColor=#d79b00;dashed=1;fontSize=12;fontStyle=1;collapsible=0;" vertex="1" parent="p1-proc">
          <mxGeometry x="40" y="860" width="1140" height="400" as="geometry" />
        </mxCell>
        <mxCell id="b30" value="&lt;b&gt;CEK CACHE RERANK&lt;/b&gt;&lt;br&gt;_get_cached_rerank_fits / _store_rerank_fits&lt;br&gt;&lt;i&gt;kunci = set pill + digest keyword + user_id +&lt;br&gt;sidik kandidat (place_id:review_count)&lt;/i&gt;&lt;br&gt;&lt;i&gt;cache hit &#8594; hemat 1 panggilan LLM&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="g3">
          <mxGeometry x="20" y="45" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b31" value="&lt;b&gt;LLM RERANK&lt;/b&gt;&lt;br&gt;llm_recommender.llm_rerank_candidates&lt;br&gt;&lt;i&gt;pool COFIND_LLM_RERANK_CANDIDATES = 7,&lt;br&gt;6 kutipan/kandidat; prompt memuat bukti ulasan,&lt;br&gt;selera user, sinyal komunitas (vote + top pros)&lt;/i&gt;&lt;br&gt;&lt;b&gt;output: fit_score 0&#8211;10, selected, alasan, indeks kutipan&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="g3">
          <mxGeometry x="400" y="45" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b32" value="&lt;b&gt;JSON REPAIR&lt;/b&gt;&lt;br&gt;_parse_llm_json_with_repair&lt;br&gt;&lt;i&gt;pustaka json_repair dulu, lalu maks 2 iterasi&lt;br&gt;perbaikan lewat LLM bila masih gagal parse&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="g3">
          <mxGeometry x="780" y="45" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b33" value="&lt;b&gt;GROUNDING CHECK&lt;/b&gt;&lt;br&gt;text_is_grounded / ungrounded_quotes&lt;br&gt;&lt;i&gt;COFIND_LLM_GROUNDING_CHECK = true&lt;br&gt;kutipan yang tidak ada di korpus ulasan dibuang&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="g3">
          <mxGeometry x="780" y="160" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b34" value="&lt;b&gt;BLEND SKOR&lt;/b&gt;&lt;br&gt;_blend_rerank_scores&lt;br&gt;&lt;b&gt;final = 0.6&#183;(fit_score/10) + 0.4&#183;skor hybrid&lt;/b&gt;&lt;br&gt;&lt;i&gt;COFIND_LLM_RERANK_WEIGHT = 0.6&lt;br&gt;(1.0 = murni LLM, 0.0 = murni retrieval)&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="g3">
          <mxGeometry x="400" y="160" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b35" value="&lt;b&gt;SELEKSI 0&#8211;3 TOKO&lt;/b&gt;&lt;br&gt;_select_top_shops (MAX_REC = 3)&lt;br&gt;&lt;i&gt;syarat: ada bukti aktivitas, selected = true,&lt;br&gt;fit_score &#8805; COFIND_LLM_MIN_FIT = 5.0&lt;/i&gt;&lt;br&gt;&lt;i&gt;slot kosong dibiarkan kosong, tidak diisi paksa&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="g3">
          <mxGeometry x="20" y="160" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b36" value="&lt;b&gt;KUTIPAN TAMPILAN&lt;/b&gt;&lt;br&gt;_apply_llm_extracted_quotes&lt;br&gt;&lt;i&gt;maks 3 modal_display_quotes (diprioritaskan&lt;br&gt;ulasan aktivitas) + 1 modal_caveat_quotes&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="g3">
          <mxGeometry x="20" y="275" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b37" value="&lt;b&gt;SUMMARY PER TOKO (PARALEL)&lt;/b&gt;&lt;br&gt;_generate_llm_review_summary &#8594;&lt;br&gt;_llm_summaries_for_shops (ThreadPoolExecutor)&lt;br&gt;&lt;i&gt;1 panggilan LLM per toko, sengaja tanpa cache&lt;br&gt;agar paragraf mengikuti kombinasi pill saat itu&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="g3">
          <mxGeometry x="400" y="275" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b38" value="&lt;b&gt;FALLBACK DETERMINISTIK&lt;/b&gt;&lt;br&gt;_build_review_summary_deterministic&lt;br&gt;&lt;i&gt;dipakai bila LLM mati / gagal parse; toko tanpa&lt;br&gt;kutipan tampilan dibuang dari hasil&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="g3">
          <mxGeometry x="780" y="275" width="340" height="100" as="geometry" />
        </mxCell>

