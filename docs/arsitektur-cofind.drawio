  <diagram id="cofind-topologi" name="2. Arsitektur Sistem &amp; Deployment">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p2-title" value="COFIND &#8212; ARSITEKTUR SISTEM &amp; TOPOLOGI DEPLOYMENT" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1400" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p2-sub" value="SPA di Vercel &#8594; Flask/gunicorn di Railway &#8594; Supabase Postgres, Redis (Upstash), dan Hugging Face Router. Worker Celery berjalan sebagai proses terpisah dan tidak berada di jalur request rekomendasi." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1700" height="30" as="geometry" />
        </mxCell>

