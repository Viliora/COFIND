        <mxCell id="i8" value="&lt;b&gt;data/indonesia_slang_map.json&lt;/b&gt;&lt;br&gt;slang_normalize.py&lt;br&gt;&lt;i&gt;normalisasi slang (bgt &#8594; banget) untuk&lt;br&gt;pencocokan leksikal kutipan/keyword&lt;/i&gt;" style="shape=note;size=15;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f9f7ed;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
