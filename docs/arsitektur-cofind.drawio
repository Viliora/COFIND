        <mxCell id="b41" value="&lt;b&gt;FINALLY&lt;/b&gt; &#8212; flush_semantic_cache + flush_clause_sentiment_cache&lt;br&gt;reset budget encode, LOG_METRIC per tahap (profile_load_ms, hybrid_retrieval_ms, rerank_ms, llm_summary_ms, total_ms)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="g4">
          <mxGeometry x="575" y="40" width="545" height="55" as="geometry" />
