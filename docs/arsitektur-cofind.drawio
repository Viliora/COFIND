<mxfile host="app.diagrams.net" type="device" pages="3">
  <diagram id="cofind-pipeline" name="1. Pipeline Rekomendasi">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="COFIND — PIPELINE REKOMENDASI (RAG 3 FASE)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="900" height="32" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Rekonstruksi diagram lama. Input hanya pill dua lapis (tanpa teks bebas). Sumber: app.py::_recommendation_pipeline_events, hybrid_retrieval.py, llm_recommender.py." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1400" height="24" as="geometry" />
        </mxCell>

        <mxCell id="actor" value="User" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="56" y="150" width="40" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pill" value="PILL SELECT&#10;1 aktivitas + maks 3 atribut" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="140" y="160" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="parse" value="PARSE + AUTH&#10;Bearer + body {preferences, attributes}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="370" y="160" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="valid" value="PILL VALIDATION&#10;PILL_MAPPING + split aktivitas/atribut" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="160" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="places" value="GOOGLE PLACES API&#10;(seeding 2025, tidak dipanggil runtime)" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;dashed=1;fontColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="140" y="360" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="db" value="SUPABASE POSTGRES&#10;coffee_shops, reviews, votes,&#10;favorites, feedback" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="390" y="330" width="190" height="120" as="geometry" />
        </mxCell>
        <mxCell id="embed" value="EMBEDDING LOKAL&#10;MiniLM-L12-v2 (in-process)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="140" y="500" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="hf" value="HF ROUTER&#10;Llama-3.1-8B-Instruct:novita" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="140" y="600" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cache" value="CACHE&#10;embedding (memori→Redis→file)&#10;rerank (TTL 7 hari)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="390" y="500" width="190" height="80" as="geometry" />
        </mxCell>

        <mxCell id="modal" value="RECOMMENDATION MODAL&#10;maks 3 kartu + kutipan + feedback" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="140" y="720" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="fb" value="FEEDBACK&#10;not_helpful → exclusion request berikutnya" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="720" width="210" height="70" as="geometry" />
        </mxCell>

        <mxCell id="proc" value="RECOMMENDATION PROCESS" style="swimlane;whiteSpace=wrap;html=1;startSize=36;fillColor=none;strokeColor=#333333;fontSize=14;fontStyle=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="880" y="90" width="1000" height="920" as="geometry" />
        </mxCell>

        <mxCell id="nonllm" value="PROSES NON-LLM  —  Fase 1 hard filter + Fase 2 hybrid retrieval" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=none;strokeColor=#82b366;fontSize=12;fontStyle=1;collapsible=0;" vertex="1" parent="proc">
          <mxGeometry x="20" y="50" width="960" height="400" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="BUILD PROFILE REVIEW&#10;batch shops + ulasan Cofind&#10;+ vote + top pros&#10;wajib ≥ 1 ulasan" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="nonllm">
          <mxGeometry x="20" y="50" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="KEYWORDS MAPPING&#10;pill + label + review_keywords&#10;→ token BM25 &amp; query dense" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="nonllm">
          <mxGeometry x="270" y="50" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="HYBRID SCORING&#10;BM25 + embedding + kualitas&#10;aktivitas 0.65 / atribut 0.25 / kualitas 0.10" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="nonllm">
          <mxGeometry x="520" y="50" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="FILTER + SORT (TOP 7)&#10;gerbang aktivitas wajib&#10;MinMax hanya toko yang lolos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="nonllm">
          <mxGeometry x="770" y="50" width="170" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="ACTIVITY GATE&#10;kata/frasa aktivitas harus ada di ulasan;&#10;wifi/colokan hanya penguat skor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="nonllm">
          <mxGeometry x="270" y="200" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="BUILD RETRIEVAL EVIDENCE&#10;scan 60 ulasan, simpan 8 terbaik&#10;+ pill coverage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="nonllm">
          <mxGeometry x="520" y="200" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="EXCLUDE not_helpful&#10;toko thumbs-down untuk set pill yang sama dibuang sebelum scoring" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="nonllm">
          <mxGeometry x="20" y="200" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="Tidak ada RRF. Fusi = MinMax lalu bobot tetap. COFIND_HYBRID_*_WEIGHT tidak dibaca retrieve_top_k." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#666666" vertex="1" parent="nonllm">
          <mxGeometry x="20" y="310" width="920" height="30" as="geometry" />
        </mxCell>

        <mxCell id="llm" value="PROSES LLM  —  Fase 3 rerank + ekstraksi kutipan + summary" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=none;strokeColor=#d79b00;fontSize=12;fontStyle=1;collapsible=0;" vertex="1" parent="proc">
          <mxGeometry x="20" y="470" width="960" height="430" as="geometry" />
        </mxCell>
        <mxCell id="l1" value="USER TASTE PROFILE&#10;ulasan sendiri + favorit + vote&#10;masuk prompt rerank" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="llm">
          <mxGeometry x="20" y="50" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="LLM RERANK (TOP 7)&#10;fit_score 0–10, selected, kutipan&#10;cache hit dapat melewati LLM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="llm">
          <mxGeometry x="270" y="50" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="GROUNDING + BLEND&#10;kutipan harus ada di ulasan asli&#10;final = 0.6·fit + 0.4·hybrid" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="llm">
          <mxGeometry x="520" y="50" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="l4" value="SELECT 0–3&#10;selected=true, fit ≥ 5.0,&#10;ada bukti aktivitas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="llm">
          <mxGeometry x="770" y="50" width="170" height="100" as="geometry" />
        </mxCell>
        <mxCell id="l5" value="EXPAND PREFERENCE KEYWORDS&#10;(LLM) — DIHAPUS&#10;makna ditangani embedding, bukan sinonim LLM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;dashed=1;fontColor=#666666;fontSize=11;" vertex="1" parent="llm">
          <mxGeometry x="20" y="180" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="l6" value="BUILD EVIDENCE &amp; SUMMARIZE&#10;kutipan tampilan + caveat&#10;1 panggilan LLM / toko (tanpa cache)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="llm">
          <mxGeometry x="520" y="180" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="l7" value="FALLBACK DETERMINISTIK&#10;jika LLM mati / gagal parse" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="llm">
          <mxGeometry x="770" y="180" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="l8" value="SSE progress: start → profiles → scoring → rerank → summary → done. Endpoint: POST /api/recommend-by-preferences[/stream]." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#666666" vertex="1" parent="llm">
          <mxGeometry x="20" y="290" width="920" height="30" as="geometry" />
        </mxCell>

