        </mxCell>
        <mxCell id="i7" value="&lt;b&gt;facilities.json&lt;/b&gt; (facilities_store.py)&lt;br&gt;&lt;i&gt;konteks tab fasilitas untuk prompt/tampilan;&lt;br&gt;bukan sinyal ranking utama&lt;/i&gt;" style="shape=note;size=15;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f9f7ed;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1660" y="910" width="380" height="100" as="geometry" />
