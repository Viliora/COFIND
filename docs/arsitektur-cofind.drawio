        <mxCell id="p2-e10" value="seeding data (sekali jalan)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#b3b3b3;endArrow=open;fontColor=#666666;exitX=1;exitY=0.5;entryX=1;entryY=0.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2-x7" target="p2-x1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="cofind-perubahan" name="3. Peta Perubahan vs Diagram Lama">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p3-title" value="PETA PERUBAHAN &#8212; DIAGRAM LAMA VS SISTEM SEKARANG" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1400" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p3-sub" value="Tiap baris memetakan kotak pada diagram lama ke kondisi kode saat ini, ditambah tahap baru yang belum tergambar sebelumnya." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1600" height="30" as="geometry" />
        </mxCell>

        <mxCell id="p3-hd1" value="TAHAP DI DIAGRAM LAMA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#333333;fontColor=#ffffff;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="340" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p3-hd2" value="STATUS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#333333;fontColor=#ffffff;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="380" y="90" width="160" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p3-hd3" value="KONDISI SEKARANG (fungsi / berkas / konstanta)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#333333;fontColor=#ffffff;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="540" y="90" width="1320" height="44" as="geometry" />
        </mxCell>

        <mxCell id="p3-r1a" value="PILL SELECT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="134" width="340" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-r1b" value="TETAP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="380" y="134" width="160" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-r1c" value="Kini dua lapis: 1 pill aktivitas (CONTEXT_PILL_OPTIONS) + maksimum 3 pill atribut fasilitas (FACILITY_ATTRIBUTE_GROUPS). Batas ditegakkan di backend: _MAX_ACTIVITY_PILLS = 1, _MAX_ATTRIBUTE_PILLS = 3." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="134" width="1320" height="74" as="geometry" />
        </mxCell>

        <mxCell id="p3-r2a" value="PARSE JSON" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="208" width="340" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-r2b" value="BERGESER" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="380" y="208" width="160" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-r2c" value="Input bukan JSON bebas: _read_recommendation_preferences() hanya menormalkan body {preferences, attributes}. Parsing JSON sekarang dipakai untuk OUTPUT LLM &#8212; _parse_llm_json_with_repair() dengan pustaka json_repair, lalu maksimum 2 iterasi perbaikan lewat LLM." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="208" width="1320" height="74" as="geometry" />
        </mxCell>

        <mxCell id="p3-r3a" value="PILL VALIDATION" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="282" width="340" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-r3b" value="TETAP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="380" y="282" width="160" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-r3c" value="Pill wajib terdaftar di PILL_MAPPING, lalu dipisah oleh _split_preference_pills() menjadi aktivitas vs atribut. Pill tak dikenal &#8594; HTTP 400. Tambahan gerbang baru: autentikasi Bearer wajib dan COFIND_DEV_LLM_STRICT (503 bila LLM wajib tetapi mati)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="282" width="1320" height="74" as="geometry" />
        </mxCell>

        <mxCell id="p3-r4a" value="BUILD PROFILE REVIEW" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="356" width="340" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-r4b" value="TETAP (jadi batch)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="380" y="356" width="160" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-r4c" value="_build_profiles_for_recommendation(): 1 query coffee_shops + 1 query reviews lean (tanpa foto/like), lalu diperkaya get_vote_summaries_batch() dan get_top_voted_pros_batch() sebagai community_signals untuk prompt rerank." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="356" width="1320" height="74" as="geometry" />
        </mxCell>

        <mxCell id="p3-r5a" value="SCORING SHOP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="340" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-r5b" value="DIGANTI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="380" y="430" width="160" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-r5c" value="Digantikan hybrid_retrieval.retrieve_top_k(): BM25 sparse + embedding dense + sinyal kualitas. Fungsi lama _score_shop_by_user_reviews() masih ada di app.py tetapi tidak lagi dipanggil (kode mati) &#8212; termasuk gerbang makna semantic_match.match_reviews." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="430" width="1320" height="74" as="geometry" />
        </mxCell>

        <mxCell id="p3-r6a" value="FILTER + SORT (TOP 10)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="504" width="340" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-r6b" value="DIGANTI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="380" y="504" width="160" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-r6c" value="Gerbang aktivitas wajib (shop_has_activity_signal) &#8594; MinMax hanya di antara toko yang lolos &#8594; top 7 (COFIND_RETRIEVAL_TOP_K), bukan top 10. Bobot: aktivitas 0.65 (0.40 bm25 + 0.35 dense + 0.25 leksikal), atribut 0.25, kualitas 0.10. Keluaran akhir 0&#8211;3 (MAX_REC = 3)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="504" width="1320" height="74" as="geometry" />
        </mxCell>

        <mxCell id="p3-r7a" value="KEYWORDS MAPPING" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="578" width="340" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-r7b" value="TETAP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="380" y="578" width="160" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-r7c" value="build_sparse_query_tokens(): pill id + label + PILL_MAPPING[...]['review_keywords'] menjadi token BM25 (dipisah token aktivitas dan atribut); build_dense_query_text() menyusun query embedding. Posisinya kini di awal Fase 2, bukan tahap terpisah di akhir." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="578" width="1320" height="74" as="geometry" />
        </mxCell>

        <mxCell id="p3-r8a" value="EXPAND PREFERENCE KEYWORDS&lt;br&gt;(LLM PREFERENCE KEYWORDS)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="652" width="340" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-r8b" value="DIHAPUS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="380" y="652" width="160" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-r8c" value="Tidak ada lagi tahap LLM untuk melebarkan kata kunci preferensi. Kedekatan makna (wifi ~ internet ~ koneksi) ditangani embedding multilingual pada Fase 2. Helper lama _expand_pill_to_keywords() hanya tersisa untuk pencocokan kutipan/evidence, bukan tahap pipeline." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="652" width="1320" height="74" as="geometry" />
        </mxCell>

        <mxCell id="p3-r9a" value="RE-RANK TOP 10" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="726" width="340" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-r9b" value="BERUBAH" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="380" y="726" width="160" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-r9c" value="llm_rerank_candidates() menilai pool 7 kandidat (COFIND_LLM_RERANK_CANDIDATES, 6 kutipan per kandidat) dan memilih 0&#8211;3. Tambahan: konteks selera user, grounding check, blend final = 0.6&#183;(fit/10) + 0.4&#183;skor hybrid, ambang fit &#8805; 5.0, serta cache hasil rerank." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="726" width="1320" height="74" as="geometry" />
        </mxCell>

        <mxCell id="p3-r10a" value="BUILD EVIDENCE &amp; SUMMARIZE&lt;br&gt;(TOP 3)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="340" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-r10b" value="DIPECAH" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="380" y="800" width="160" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-r10c" value="Menjadi tiga langkah: _build_retrieval_evidence() (rank_reviews_for_query: scan 60 ulasan, simpan 8) &#8594; _apply_llm_extracted_quotes() (maks 3 kutipan tampilan + 1 caveat) &#8594; _llm_summaries_for_shops() (ThreadPoolExecutor, 1 panggilan LLM per toko, tanpa cache) dengan fallback deterministik." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="800" width="1320" height="74" as="geometry" />
        </mxCell>

        <mxCell id="p3-r11a" value="GOOGLE PLACES API &#8594; DATABASE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="874" width="340" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-r11b" value="TIDAK AKTIF" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="380" y="874" width="160" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-r11c" value="Tidak ada pemanggilan Places API di kode runtime; GOOGLE_PLACES_API_KEY hanya tersisa di .env.example. Data toko sudah berada di Supabase Postgres (seeding 2025, kini dikelola panel admin); rating Google hanya bagian sinyal kualitas (~10%). Peta memakai OpenStreetMap via Leaflet." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="874" width="1320" height="74" as="geometry" />
        </mxCell>

        <mxCell id="p3-r12a" value="GERBANG AUTENTIKASI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="948" width="340" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-r12b" value="BARU" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="380" y="948" width="160" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-r12c" value="Seluruh endpoint rekomendasi mewajibkan login: auth_guards.require_authenticated_user() memverifikasi token Bearer terhadap sesi di Postgres. Diagram lama tidak punya lapis ini." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="948" width="1320" height="74" as="geometry" />
        </mxCell>

        <mxCell id="p3-r13a" value="FEEDBACK LOOP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="1022" width="340" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-r13b" value="BARU" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="380" y="1022" width="160" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-r13c" value="recommendation_feedback_utils: thumbs up/down per (user, place_id, set pill). get_not_helpful_place_ids() mengeluarkan toko yang ditandai tidak relevan dari kandidat pada permintaan berikutnya dengan preferensi yang sama." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="1022" width="1320" height="74" as="geometry" />
        </mxCell>

        <mxCell id="p3-r14a" value="PERSONALISASI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="1096" width="340" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-r14b" value="BARU" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="380" y="1096" width="160" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-r14c" value="build_user_taste_profile() + format_user_taste_prompt_block(): ulasan pengguna sendiri, favorit, dan vote ikut masuk prompt rerank (COFIND_LLM_PERSONALIZATION). Karena itu user_id menjadi bagian kunci cache rerank." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="1096" width="1320" height="74" as="geometry" />
        </mxCell>

        <mxCell id="p3-r15a" value="PROGRESS STREAMING (SSE)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="1170" width="340" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-r15b" value="BARU" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="380" y="1170" width="160" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-r15c" value="POST /api/recommend-by-preferences/stream mengirim event progress per tahap (start 6%, profiles 22%, scoring 48%, rerank 72%, summary 88%, done 100%) lalu satu event result. Klien memakai fetch + ReadableStream karena butuh header Authorization." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="1170" width="1320" height="74" as="geometry" />
        </mxCell>

        <mxCell id="p3-r16a" value="CACHE BERLAPIS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="1244" width="340" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-r16b" value="BARU" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="380" y="1244" width="160" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-r16c" value="Embedding: memori &#8594; Redis &#8594; cache/semantic_embeddings.json (TTL 30 hari, maks 200.000 entri, flush 1x per request). Rerank: cache/rerank_cache.json (TTL 7 hari; kunci = pill + keyword + user_id + sidik kandidat). Ringkasan sengaja tanpa cache." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="1244" width="1320" height="74" as="geometry" />
        </mxCell>

        <mxCell id="p3-r17a" value="GROUNDING + TELEMETRI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="1318" width="340" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-r17b" value="BARU" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="380" y="1318" width="160" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-r17c" value="text_is_grounded() / ungrounded_quotes() membuang kutipan yang tidak ditemukan di korpus ulasan (COFIND_LLM_GROUNDING_CHECK). Respons memuat blok llm_pipeline (config, retrieval, rerank, semantic) dan LOG_METRIC mencatat durasi tiap tahap." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="1318" width="1320" height="74" as="geometry" />
        </mxCell>

        <mxCell id="p3-r18a" value="MODUL DORMAN (catatan)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;dashed=1;fontColor=#666666;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="1392" width="340" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-r18b" value="NONAKTIF" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;dashed=1;fontColor=#666666;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="380" y="1392" width="160" height="74" as="geometry" />
        </mxCell>
