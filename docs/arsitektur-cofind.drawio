        <mxCell id="p1-infratitle" value="DATA, MODEL &amp; CACHE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1660" y="60" width="380" height="30" as="geometry" />
        </mxCell>
        <mxCell id="i1" value="&lt;b&gt;SUPABASE POSTGRES&lt;/b&gt;&lt;br&gt;db_backend.py (DATABASE_URL)&lt;br&gt;&lt;i&gt;coffee_shops, reviews, users, sessions,&lt;br&gt;favorites, shop_votes, shop_pros_cons,&lt;br&gt;recommendation_feedback, preference_suggestions&lt;/i&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1660" y="100" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="i2" value="&lt;b&gt;HUGGING FACE ROUTER&lt;/b&gt; (OpenAI-compatible)&lt;br&gt;llm_backend.py &#8594; router.huggingface.co/v1&lt;br&gt;&lt;i&gt;HF_MODEL = meta-llama/Llama-3.1-8B-Instruct:novita&lt;br&gt;cap 900 token, timeout 60s, 1 retry&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1660" y="255" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="i3" value="&lt;b&gt;MODEL EMBEDDING (IN-PROCESS)&lt;/b&gt;&lt;br&gt;sentence-transformers&lt;br&gt;paraphrase-multilingual-MiniLM-L12-v2&lt;br&gt;&lt;i&gt;bukan API; preload saat startup&lt;br&gt;(COFIND_SEMANTIC_PRELOAD = true)&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1660" y="390" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="i4" value="&lt;b&gt;VECTOR CACHE 3 LAPIS&lt;/b&gt;&lt;br&gt;vector_cache.PersistentCache&lt;br&gt;&lt;i&gt;memori &#8594; Redis &#8594; cache/semantic_embeddings.json&lt;br&gt;TTL 30 hari, maks 200.000 entri&lt;br&gt;flush ke file 1x per request&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1660" y="525" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="i5" value="&lt;b&gt;REDIS / UPSTASH&lt;/b&gt; (redis_utils.py)&lt;br&gt;&lt;i&gt;broker + backend Celery, lapis-2 vector cache,&lt;br&gt;dipakai /health&lt;/i&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1660" y="670" width="380" height="100" as="geometry" />
        </mxCell>
        <mxCell id="i6" value="&lt;b&gt;FILE CACHE RERANK&lt;/b&gt;&lt;br&gt;cache/rerank_cache.json&lt;br&gt;&lt;i&gt;TTL 7 hari (cache_paths.py)&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
