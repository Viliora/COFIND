        </mxCell>
        <mxCell id="b40" value="&lt;b&gt;RESPONS&lt;/b&gt; &#8212; event SSE &lt;i&gt;result&lt;/i&gt; / JSON sekali kirim&lt;br&gt;recommendations[] + preferences + search_keywords + llm_pipeline (config, retrieval, rerank, semantic)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="g4">
          <mxGeometry x="20" y="40" width="545" height="55" as="geometry" />
