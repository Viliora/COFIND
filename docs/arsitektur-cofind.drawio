  <diagram id="cofind-topologi" name="2. Arsitektur Sistem &amp; Deployment">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p2-title" value="COFIND &#8212; ARSITEKTUR SISTEM &amp; TOPOLOGI DEPLOYMENT" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1400" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p2-sub" value="SPA di Vercel &#8594; Flask/gunicorn di Railway &#8594; Supabase Postgres, Redis (Upstash), dan Hugging Face Router. Worker Celery berjalan sebagai proses terpisah dan tidak berada di jalur request rekomendasi." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1700" height="30" as="geometry" />
        </mxCell>

        <mxCell id="p2-client" value="BROWSER / SPA &#8212; frontend-cofind (Vercel)" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=none;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="520" height="620" as="geometry" />
        </mxCell>
        <mxCell id="p2-cl1" value="&lt;b&gt;HALAMAN&lt;/b&gt; (React Router 7)&lt;br&gt;ShopList (pemilih pill + rekomendasi), ShopDetail,&lt;br&gt;Favorite, WantToVisit, Profile, Login, About, Admin" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="p2-client">
          <mxGeometry x="20" y="50" width="480" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2-cl2" value="&lt;b&gt;KOMPONEN KUNCI&lt;/b&gt;&lt;br&gt;RecommendationModal (top 3 + kutipan + feedback),&lt;br&gt;RecommendationProgressOverlay (SSE), FacilityAttributePicker,&lt;br&gt;ShopVoteModal, ShopProsCons, FacilitiesTab,&lt;br&gt;CoffeeShopMap / CoffeeShopRadiusMap (react-leaflet)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="p2-client">
          <mxGeometry x="20" y="155" width="480" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p2-cl3" value="&lt;b&gt;SERVICES&lt;/b&gt;&lt;br&gt;recommendationStream.js (SSE + fallback JSON),&lt;br&gt;authService.js, adminService.js" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="p2-client">
          <mxGeometry x="20" y="285" width="480" height="85" as="geometry" />
        </mxCell>
