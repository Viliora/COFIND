# Example backend environment variables
# Copy this file to .env and fill in your actual API key.
GOOGLE_PLACES_API_KEY=YOUR_API_KEY_HERE
HF_API_TOKEN=YOUR_HF_TOKEN_HERE
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct:novita

# Fallback LLM: Google AI Studio (Gemini), OpenAI-compatible — dipakai jika HF 402/quota/gagal
# GEMINI_API_KEY=your-google-ai-studio-key
# Flash (cepat, ringkas) vs Pro (paragraf panjang — coba jika summary Gemini terlalu pendek):
# GEMINI_MODEL=gemini-2.5-pro
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_PROJECT_ID=your-gcp-project-id
# COFIND_LLM_GEMINI_FALLBACK=true
# Probe sekali di awal pipeline rekomendasi (route hf|gemini|off, anti-spam log fallback)
COFIND_LLM_PROBE_RECOMMEND=true
# COFIND_LLM_PROBE_TIMEOUT_SECONDS=60

# LLM backend (Hugging Face Router, OpenAI-compatible)
HF_LLM_BACKEND=inference
# Optional alias token variable if you prefer HF_TOKEN naming
# HF_TOKEN=YOUR_HF_TOKEN_HERE
HF_LLM_TIMEOUT_SECONDS=60
HF_LLM_MAX_RETRIES=1
HF_LLM_BACKOFF_FACTOR=0.8
# Batas token output chat completion; prompt ringkasan rekomendasi butuh ruang >512.
HF_LLM_MAX_CHAT_TOKENS_CAP=900
COFIND_DEV_LLM_STRICT=false

# Pipeline rekomendasi RAG 3 fase: hard filter + hybrid retrieval + LLM rerank.
# Fase 1: pill valid; min 1 ulasan pipeline (Cofind + Google Places, lihat review_utils).
# Fase 2: BM25 + dense/ANN → Reciprocal Rank Fusion (RRF), normalisasi rrf_norm,
#         blend 0.9/0.1 dengan skor kualitas toko (hardcoded di _hybrid_retrieve_rrf_core). Top 7.
# PILL_MAPPING dipakai sebagai teks query, bukan gerbang lolos/gugur.
# LEGACY — tidak memengaruhi jalur RRF aktif (_hybrid_retrieve_rrf_core); hanya _blend_weights().
COFIND_HYBRID_BM25_WEIGHT=0.45
COFIND_HYBRID_DENSE_WEIGHT=0.45
COFIND_HYBRID_QUALITY_WEIGHT=0.10
# RRF: konstanta k dan lebar pool per daftar peringkat (BM25, dense, opsional lex aktivitas).
COFIND_RRF_K=60
COFIND_RRF_POOL_SIZE=50
# Metadata fasilitas resmi (Google/owner) hanya prior lemah. Ulasan tetap
# penentu skor. Kontradiksi ulasan memotong prior lalu menambah penalti.
COFIND_METADATA_GATE=true
COFIND_METADATA_PRIOR_WEIGHT=0.08
COFIND_METADATA_PENALTY_WEIGHT=0.18
COFIND_RETRIEVAL_TOP_K=7
# Dense toko = cosine tertinggi di antara ulasan (bukan 320 karakter pertama).
COFIND_DENSE_MAX_REVIEWS=20
# Kutipan LLM: scan hingga N ulasan, simpan 8 paling relevan (rerank memakai 6).
COFIND_PROMPT_REVIEW_SCAN=60
COFIND_PROMPT_REVIEW_LIMIT=8
# Gerbang aktivitas Fase 2: kata/frasa aktivitas ATAU cosine aktivitas >= ambang.
# Cosine memakai query aktivitas saja (bukan campur wifi/colokan).
# activity_pass_dense_only di telemetry = toko yang lolos hanya karena cosine.
COFIND_ACTIVITY_DENSE_MIN=0.55
# Fase 3: LLM menilai pool retrieval, pilih 0–3 toko yang kutipannya mendukung aktivitas.
COFIND_LLM_RERANK=true
COFIND_LLM_MIN_FIT=5.0
# Naikkan HF_LLM_MAX_CHAT_TOKENS_CAP (mis. 1024) bila memakai lebih dari 7 kandidat,
# supaya JSON penilaian LLM tidak terpotong.
COFIND_LLM_RERANK_CANDIDATES=7
# Penilaian rerank LLM disimpan per (kombinasi pill + user + susunan kandidat
# beserta jumlah ulasannya). user_id ikut ke kunci karena prompt rerank memuat
# konteks selera user; tanpa itu user lain akan memakai hasil personalisasi
# orang pertama. Satu ulasan baru mengubah kunci, jadi cache tidak menyembunyikan
# ulasan terbaru.
COFIND_LLM_RERANK_CACHE=true
# 1.0 = urutan murni LLM, 0.0 = urutan murni skor retrieval.
COFIND_LLM_RERANK_WEIGHT=0.6
# Tahap C: konteks selera user (review sendiri + favorit) ikut dikirim ke prompt rerank.
COFIND_LLM_PERSONALIZATION=true
# Tahap D: kutipan yang diklaim LLM harus ada di review asli, kalau tidak akan dibuang.
COFIND_LLM_GROUNDING_CHECK=true
# Modal quote summary default deterministik. Set true jika ingin LLM per toko.
COFIND_MODAL_QUOTE_LLM=false
# Step 5 explanation: tolak ringkasan LLM terlalu pendek; retry sekali saat fallback Gemini.
COFIND_SUMMARY_MIN_CHARS=120
COFIND_SUMMARY_MAX_TOKENS=400
COFIND_SUMMARY_GEMINI_RETRY=true
# false = izinkan retry Gemini jika summary ditolak validator (disarankan saat HF 402)
COFIND_SUMMARY_GEMINI_SINGLE_SHOT=false
COFIND_SUMMARY_DEBUG_LOG=true
GEMINI_SUMMARY_MAX_TOKENS=1024
# Log detail scoring per toko (default ringkas).
COFIND_RECOMMEND_VERBOSE=false

# --- Embedding dense untuk Hybrid Retrieval -----------------------------------
# Model yang sama dipakai untuk cosine similarity query vs korpus review toko
# (mis. "wifi" ~ "koneksi" ~ "internet" tanpa hardcode sinonim).
COFIND_SEMANTIC_GATE=true
COFIND_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Ambang cosine hanya untuk utilitas/smoke test lama, bukan gerbang kandidat RAG.
COFIND_SEMANTIC_THRESHOLD=0.55
COFIND_SEMANTIC_MAX_CLAUSES=80
COFIND_SEMANTIC_BATCH_SIZE=32
COFIND_SEMANTIC_SCORE_CAP=0.6
COFIND_SEMANTIC_ENCODE_BUDGET=1500
# Paksa device torch bila perlu (mis. cpu). Default: auto.
# COFIND_EMBEDDING_DEVICE=cpu
# Produksi: muat model saat startup agar request pertama tidak menunggu load model.
COFIND_SEMANTIC_PRELOAD=true

# --- Sentimen kutipan kandidat (LLM) ------------------------------------------
# false = pipeline lama (heuristik caveat). true = LLM menilai kutipan pool
# kecil sebelum rerank; rule hanya fallback bila verdict tidak ada.
# COFIND_LLM_CLAUSE_SENTIMENT=false
COFIND_CLAUSE_SENTIMENT_BATCH=24
COFIND_CLAUSE_SENTIMENT_MAX=96
COFIND_CLAUSE_SENTIMENT_POOL=6
COFIND_CLAUSE_SENTIMENT_CONCURRENCY=3

# --- Legacy coverage (scorer lama, bukan jalur RAG) ---------------------------
COFIND_COVERAGE_BONUS=0.25
COFIND_ACTIVITY_COVERAGE_SHARE=0.6
COFIND_COVERAGE_SEMANTIC_MIN=0.65


# --- Review embeddings (pgvector @ Supabase) -----------------------------------
# pgvector = persist di review_embeddings; cache = Redis/file only (legacy)
COFIND_EMBEDDING_STORE=cache
COFIND_PGVECTOR_DIM=384
# Dense Fase 2: ANN pgvector scoped ke place_id Fase 1 (default on bila pgvector)
# COFIND_DENSE_USE_ANN=true
COFIND_ANN_TOP_K=300
# Queue embed setelah tulis ulasan (butuh Celery worker + REDIS_URL)
COFIND_EMBEDDING_ASYNC=false
# --- Cache vektor & verdict ---------------------------------------------------
# Query/klausa/verdict LLM — BUKAN vektor review (review = pgvector di atas).
# Lapis: memori -> Redis (REDIS_URL) -> file cache/.
COFIND_VECTOR_CACHE=true
COFIND_VECTOR_CACHE_REDIS=true
COFIND_VECTOR_CACHE_TTL_DAYS=30
COFIND_VECTOR_CACHE_MAX=200000

# --- Logging ------------------------------------------------------------------
# Level default seluruh logger `cofind` (DEBUG | INFO | WARNING | ERROR).
COFIND_LOG_LEVEL=INFO
# Override per area bila perlu menelusuri satu bagian saja. Area yang tersedia:
# startup, api, admin, review, recommend, metric, cache, semantic, llm,
# facilities, slang, votes, pros_cons, feedback.
# Contoh: log detail per-toko pada pipeline rekomendasi (skip/keep/drop kandidat).
# COFIND_LOG_LEVEL_RECOMMEND=DEBUG

# Celery (analisis sentimen admin). Broker/backend = REDIS_URL.
# Lokal: redis://127.0.0.1:6379/0
# Upstash: rediss://default:PASSWORD@xxxx.upstash.io:6379  (wajib rediss:// untuk TLS)
REDIS_URL=rediss://default:YOUR_UPSTASH_PASSWORD@YOUR_ENDPOINT.upstash.io:6379
COFIND_SUMMARY_TASK_TIME_LIMIT_SECONDS=300
COFIND_SUMMARY_TASK_SOFT_TIME_LIMIT_SECONDS=240
COFIND_JOB_RESULT_TTL_SECONDS=3600
CELERY_WORKER_CONCURRENCY=1

# Optional: override Flask host/port (used if you modify app.run)
# FLASK_RUN_PORT=5000
# FLASK_RUN_HOST=127.0.0.1

# Frontend (Vercel): variabel VITE_* hanya di frontend-cofind/.env (lokal) atau Vercel.
# Jangan taruh VITE_GOOGLE_MAPS_API_KEY di file .env backend ini — Vite tidak membacanya.
# Lihat frontend-cofind/.env.example (VITE_API_BASE, Supabase, VITE_MAP_PROVIDER, Maps key).
# VITE_API_BASE=https://YOUR-RAILWAY-SERVICE.up.railway.app

# CORS origins yang diizinkan (comma-separated). Default: Vercel + localhost Vite.
# CORS_ORIGINS=https://cofind-pi.vercel.app,http://localhost:5173

# --- Supabase Postgres (Cofind) ---
# Jika DATABASE_URL ter-set, aplikasi memakai Postgres kecuali Anda paksa SQLite di bawah.
# COFIND_DB_BACKEND=sqlite   # paksa kofind.db lokal (kode SQLite tetap ada)
# COFIND_DB_BACKEND=postgres # eksplisit pakai DATABASE_URL
# Direct (sering IPv6-only):
# DATABASE_URL=postgresql://postgres:PASSWORD@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Shared pooler (IPv4-friendly; user = postgres.<project-ref>):
# DATABASE_URL=postgresql://postgres.<project-ref>:PASSWORD@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# SUPABASE_DB_URL=...        # alias opsional untuk DATABASE_URL
# Password: URL-encode karakter khusus (@ -> %40). Port pooler bisa 5432 atau 6543 — ikuti Connection string di dashboard.
# Pastikan tabel inti (users, coffee_shops, reviews, favorites, shop_votes, dll.) sudah ada di Supabase.
