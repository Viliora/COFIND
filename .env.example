# Example backend environment variables
# Copy this file to .env and fill in your actual API key.
GOOGLE_PLACES_API_KEY=YOUR_API_KEY_HERE
HF_API_TOKEN=YOUR_HF_TOKEN_HERE
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct:novita

# LLM backend (Hugging Face Router, OpenAI-compatible)
HF_LLM_BACKEND=inference
# Optional alias token variable if you prefer HF_TOKEN naming
# HF_TOKEN=YOUR_HF_TOKEN_HERE
HF_LLM_TIMEOUT_SECONDS=30
HF_LLM_MAX_RETRIES=2
HF_LLM_BACKOFF_FACTOR=0.8
COFIND_DEV_LLM_STRICT=false

# Pipeline rekomendasi: seed pill + BM25 hybrid + top-N (tanpa ekspansi keyword LLM / tanpa rerank).
COFIND_RERANK_BACKEND=none
# Modal quote summary default deterministik. Set true jika ingin LLM per toko.
COFIND_MODAL_QUOTE_LLM=false
# Log detail scoring per toko (default ringkas).
COFIND_RECOMMEND_VERBOSE=false

# Async summary worker (Celery). Broker/backend = REDIS_URL.
COFIND_SUMMARY_ASYNC=true
# Lokal: redis://127.0.0.1:6379/0
# Upstash: rediss://default:PASSWORD@xxxx.upstash.io:6379  (wajib rediss:// untuk TLS)
REDIS_URL=rediss://default:YOUR_UPSTASH_PASSWORD@YOUR_ENDPOINT.upstash.io:6379
COFIND_SUMMARY_TASK_TIME_LIMIT_SECONDS=300
COFIND_SUMMARY_TASK_SOFT_TIME_LIMIT_SECONDS=240
COFIND_JOB_RESULT_TTL_SECONDS=3600
CELERY_WORKER_CONCURRENCY=1

# Optional: override Flask host/port (used if you modify app.run)
# FLASK_RUN_PORT=5000
# FLASK_RUN_HOST=127.0.0.1

# Frontend (Vercel): set VITE_API_BASE ke URL publik Railway (HTTPS), bukan localhost.
# Lihat juga frontend-cofind/.env.example
# VITE_API_BASE=https://YOUR-RAILWAY-SERVICE.up.railway.app

# CORS origins yang diizinkan (comma-separated). Default: Vercel + localhost Vite.
# CORS_ORIGINS=https://cofind-pi.vercel.app,http://localhost:5173

# --- Supabase Postgres (Cofind) ---
# Jika DATABASE_URL ter-set, aplikasi memakai Postgres kecuali Anda paksa SQLite di bawah.
# COFIND_DB_BACKEND=sqlite   # paksa kofind.db lokal (kode SQLite tetap ada)
# COFIND_DB_BACKEND=postgres # eksplisit pakai DATABASE_URL
# Direct (sering IPv6-only):
# DATABASE_URL=postgresql://postgres:PASSWORD@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Shared pooler (IPv4-friendly; user = postgres.<project-ref>):
# DATABASE_URL=postgresql://postgres.<project-ref>:PASSWORD@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# SUPABASE_DB_URL=...        # alias opsional untuk DATABASE_URL
# Password: URL-encode karakter khusus (@ -> %40). Port pooler bisa 5432 atau 6543 — ikuti Connection string di dashboard.
# Pastikan tabel inti (users, coffee_shops, reviews, favorites, shop_votes, dll.) sudah ada di Supabase.
